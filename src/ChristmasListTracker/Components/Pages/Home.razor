@page "/"
@implements IDisposable
@using ChristmasListTracker.Models
@using ChristmasListTracker.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ChristmasListService ListService
@inject CurrentUserState CurrentUser
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>Christmas Lists</PageTitle>

<main class="list-page @(IsViewingOwnList ? "list-page-with-add" : "")">
    @if (!_initialized)
    {
        <p class="status-message" role="status">Loading family lists...</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="notice notice-error" role="alert">@_error</div>
        <button class="secondary-button" @onclick="InitializeAsync">Try again</button>
    }
    else if (_currentUser is null)
    {
        <section class="welcome-panel">
            <p class="eyebrow">A little more Christmas magic</p>
            <h1>Select yourself to get started</h1>
            @if (_users.Count == 0)
            {
                <p>No family members have been added to the database yet.</p>
            }
            else
            {
                <label for="user-picker">Your name</label>
                <select id="user-picker" class="form-select" @onchange="SelectUserAsync">
                    <option value="">Choose your name</option>
                    @foreach (var user in _users)
                    {
                        <option value="@user.Id">@user.DisplayName</option>
                    }
                </select>
                <p class="fine-print">This remembers your selection on this browser. It is not a secure login.</p>
            }
        </section>
    }
    else
    {
        <header class="list-heading">
            <p class="eyebrow">Christmas wish list</p>
            <h1>@(_selectedUser?.Id == _currentUser.Id ? "My list" : $"{_selectedUser?.DisplayName}'s list")</h1>
            <label for="list-picker">Browse a family list</label>
            <select id="list-picker" class="form-select" value="@_selectedListId" @onchange="SelectListAsync">
                @foreach (var user in _users)
                {
                    <option value="@user.Id">@user.DisplayName</option>
                }
            </select>
            @if (!IsViewingOwnList)
            {
                <label class="filter-toggle">
                    <input type="checkbox" @bind="_showUnpurchasedOnly" />
                    <span>Show only items not yet bought</span>
                </label>
            }
        </header>

        @if (!string.IsNullOrEmpty(_notice))
        {
            <div class="notice @(_noticeIsError ? "notice-error" : "notice-success")" role="status">@_notice</div>
        }

        @if (_loadingList)
        {
            <p class="status-message" role="status">Loading this list...</p>
        }
        else if (_items.Count == 0)
        {
            <p class="empty-message">This list is empty for now.</p>
        }
        else if (!DisplayedItems.Any())
        {
            <p class="empty-message">Everything on this list has been bought.</p>
        }
        else
        {
            <section class="list-grid" aria-label="Christmas list items">
                @foreach (var item in DisplayedItems)
                {
                    <article class="list-card">
                        <img src="@item.ImageUrl" alt="Screenshot from @_selectedUser?.DisplayName's Christmas list" loading="lazy" />
                        @if (item.ImageStatus == "processing")
                        {
                            <p class="image-status">Compressing image...</p>
                        }
                        else if (item.ImageStatus == "failed")
                        {
                            <p class="image-status image-status-error">Compression failed; showing the original image.</p>
                        }
                        @if (IsViewingOwnList)
                        {
                            <div class="owner-actions">
                                <button class="remove-button"
                                        type="button"
                                        disabled="@_removingItems.Contains(item.Id)"
                                        @onclick="() => RemoveItemAsync(item)">
                                    @(_removingItems.Contains(item.Id) ? "Removing..." : "Remove item")
                                </button>
                            </div>
                        }
                        @if (_selectedUser?.Id != _currentUser.Id)
                        {
                            <div class="purchase-row">
                                <label>
                                    <input type="checkbox"
                                           checked="@(item.IsPurchased == true)"
                                           disabled="@(item.IsPurchased == true && item.PurchasedByName != _currentUser.DisplayName || _updatingItems.Contains(item.Id))"
                                           @onchange="args => SetPurchasedAsync(item, args)" />
                                    <span>I've bought this</span>
                                </label>
                                @if (item.IsPurchased == true)
                                {
                                    <span class="purchase-status">Bought by @item.PurchasedByName</span>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }

        @if (_selectedUser?.Id == _currentUser.Id)
        {
            <div class="add-action-bar">
                <p class="upload-hint">Add one or more screenshots (JPEG or PNG, up to 20 MB each).</p>
                <input id="list-image-picker"
                       @ref="_uploadInput"
                       class="file-picker"
                       type="file"
                       @onchange="UploadImagesAsync"
                       accept="image/jpeg,image/png"
                       multiple
                       disabled="@_uploading" />
                <label class="add-button @(_uploading ? "add-button-disabled" : "")" for="list-image-picker">
                    <span>@(_uploading ? _uploadStatus : "Add")</span>
                </label>
            </div>
        }
    }
</main>

@code {
    private const int MaxFilesPerUpload = 10;
    private const long MaxUploadBytes = 20 * 1024 * 1024;

    private IReadOnlyList<FamilyUser> _users = [];
    private IReadOnlyList<ChristmasListItem> _items = [];
    private readonly HashSet<Guid> _updatingItems = [];
    private readonly HashSet<Guid> _removingItems = [];
    private ElementReference _uploadInput;
    private FamilyUser? _currentUser;
    private FamilyUser? _selectedUser;
    private string _selectedListId = "";
    private string? _error;
    private string? _notice;
    private bool _noticeIsError;
    private bool _initialized;
    private bool _loadingList;
    private bool _uploading;
    private bool _showUnpurchasedOnly;
    private string _uploadStatus = "Uploading...";

    private bool IsViewingOwnList => _currentUser is not null && _selectedUser?.Id == _currentUser.Id;
    private IEnumerable<ChristmasListItem> DisplayedItems =>
        _showUnpurchasedOnly ? _items.Where(item => item.IsPurchased != true) : _items;

    protected override void OnInitialized()
    {
        CurrentUser.Changed += OnCurrentUserChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task InitializeAsync()
    {
        _error = null;
        try
        {
            _users = await ListService.GetUsersAsync();
            var savedUserId = await JS.InvokeAsync<string?>("christmasList.getUserId");
            _currentUser = Guid.TryParse(savedUserId, out var userId)
                ? _users.FirstOrDefault(user => user.Id == userId)
                : null;
            CurrentUser.SetUser(_currentUser);
            if (_currentUser is not null)
            {
                _selectedListId = _currentUser.Id.ToString();
                await LoadSelectedListAsync();
            }
        }
        catch (Exception exception)
        {
            _error = $"Unable to load the family lists. {exception.Message}";
        }
        finally
        {
            _initialized = true;
        }
    }

    private async Task SelectUserAsync(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var userId))
        {
            return;
        }

        var user = _users.FirstOrDefault(candidate => candidate.Id == userId);
        if (user is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("christmasList.setUserId", user.Id.ToString());
        }
        catch (JSException exception)
        {
            _notice = $"Unable to remember this selection in the browser. {exception.Message}";
            _noticeIsError = true;
            return;
        }

        _currentUser = user;
        CurrentUser.SetUser(user);
        _selectedListId = user.Id.ToString();
        await LoadSelectedListAsync();
    }

    private async Task SelectListAsync(ChangeEventArgs args)
    {
        _selectedListId = args.Value?.ToString() ?? "";
        _notice = null;
        await LoadSelectedListAsync();
    }

    private async Task LoadSelectedListAsync()
    {
        if (_currentUser is null ||
            !Guid.TryParse(_selectedListId, out var ownerId) ||
            _users.All(user => user.Id != ownerId))
        {
            _items = [];
            _selectedUser = null;
            return;
        }

        _selectedUser = _users.First(user => user.Id == ownerId);
        _loadingList = true;
        try
        {
            _items = await ListService.GetListAsync(ownerId, _currentUser.Id);
        }
        catch (Exception exception)
        {
            _items = [];
            _notice = $"Unable to load this list. {exception.Message}";
            _noticeIsError = true;
        }
        finally
        {
            _loadingList = false;
        }
    }

    private async Task SetPurchasedAsync(ChristmasListItem item, ChangeEventArgs args)
    {
        if (_currentUser is null || !bool.TryParse(args.Value?.ToString(), out var purchased))
        {
            return;
        }

        _notice = null;
        _updatingItems.Add(item.Id);
        try
        {
            var updated = await ListService.SetPurchasedAsync(item.Id, _currentUser.Id, purchased);
            await LoadSelectedListAsync();
            if (!updated)
            {
                _notice = "Someone else may have updated this item. The list has been refreshed.";
                _noticeIsError = false;
            }
        }
        catch (Exception exception)
        {
            _notice = $"Unable to update the purchase status. {exception.Message}";
            _noticeIsError = true;
        }
        finally
        {
            _updatingItems.Remove(item.Id);
        }
    }

    private async Task RemoveItemAsync(ChristmasListItem item)
    {
        if (_currentUser is null || !IsViewingOwnList || _removingItems.Contains(item.Id))
        {
            return;
        }

        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Remove this item and its screenshot from your Christmas list?");
        }
        catch (JSException exception)
        {
            _notice = $"Unable to confirm item removal. {exception.Message}";
            _noticeIsError = true;
            return;
        }

        if (!confirmed)
        {
            return;
        }

        _notice = null;
        _removingItems.Add(item.Id);
        try
        {
            var result = await ListService.DeleteItemAsync(item.Id, _currentUser.Id);
            _notice = result is null
                ? "This item was already removed."
                : result.ImageCleanupPending
                    ? "Item removed. Its screenshot is queued for cleanup."
                    : "Item and screenshot removed.";
            _noticeIsError = false;
            await LoadSelectedListAsync();
        }
        catch (Exception exception)
        {
            _notice = $"Unable to remove this item. {exception.Message}";
            _noticeIsError = true;
        }
        finally
        {
            _removingItems.Remove(item.Id);
        }
    }

    private async Task UploadImagesAsync(ChangeEventArgs args)
    {
        if (_currentUser is null)
        {
            return;
        }

        _uploading = true;
        _notice = null;
        using var progressReference = DotNetObjectReference.Create(this);
        try
        {
            var result = await JS.InvokeAsync<BrowserUploadResult>(
                "christmasList.uploadFiles",
                _uploadInput,
                progressReference,
                MaxFilesPerUpload,
                MaxUploadBytes);

            _notice = result.Errors.Length == 0
                ? $"Uploaded {result.Uploaded} screenshot{(result.Uploaded == 1 ? "" : "s")}. Compression will finish in the background."
                : $"{result.Uploaded} uploaded; {result.Errors.Length} failed. {string.Join(" ", result.Errors)}";
            _noticeIsError = result.Errors.Length > 0;
            await LoadSelectedListAsync();
        }
        catch (JSException exception)
        {
            Logger.LogError(exception, "Direct-to-R2 browser upload failed.");
            _notice = $"Upload failed. {exception.Message}";
            _noticeIsError = true;
        }
        finally
        {
            _uploading = false;
            _uploadStatus = "Uploading...";
        }
    }

    [JSInvokable]
    public Task ReportUploadProgressAsync(int fileNumber, int fileCount, int percent)
    {
        _uploadStatus = $"Uploading {fileNumber} of {fileCount} ({percent}%)...";
        return InvokeAsync(StateHasChanged);
    }

    private void OnCurrentUserChanged()
    {
        _ = InvokeAsync(() =>
        {
            _currentUser = CurrentUser.User;
            StateHasChanged();
        });
    }

    public sealed record BrowserUploadResult(int Uploaded, string[] Errors);

    public void Dispose()
    {
        CurrentUser.Changed -= OnCurrentUserChanged;
    }
}
